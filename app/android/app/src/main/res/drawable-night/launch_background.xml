<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-mode splash: the dark surface colour (brand.dart `BrandColors.dark`)
     with the launcher logo centred, so no light flash before the dark UI. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#18140F" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
