{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sportsballvideo.dev/schemas/manifest.schema.json",
  "title": "Recording manifest",
  "description": "Written by the Main phone and uploaded after recording stops. Lists every segment both phones are expected to upload; processing starts only once every listed segment is in S3.",
  "type": "object",
  "required": ["schemaVersion", "gameId", "sessionId", "createdAt", "devices", "clockSync"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "gameId": { "type": "string", "description": "Game this recording belongs to. A game can have several sessions (e.g. one per half)." },
    "sessionId": { "type": "string", "description": "One continuous start-to-stop recording on both phones." },
    "createdAt": { "type": "string", "format": "date-time" },
    "devices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/device" }
    },
    "clockSync": {
      "type": "object",
      "description": "BLE ping/pong estimate of the Secondary clock relative to the Main clock. Only a starting point; processing refines the offset by cross-correlating audio.",
      "required": ["secondaryOffsetMs", "medianRttMs", "samples"],
      "additionalProperties": false,
      "properties": {
        "secondaryOffsetMs": { "type": "number", "description": "secondaryClock - mainClock, in milliseconds." },
        "medianRttMs": { "type": "number", "minimum": 0 },
        "samples": { "type": "integer", "minimum": 1 }
      }
    },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "description": "Mount used, e.g. a dual-phone tripod mount." },
        "heightM": { "type": "number", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "required": ["deviceId", "role", "platform", "model", "video", "segments"],
      "additionalProperties": false,
      "properties": {
        "deviceId": { "type": "string" },
        "role": { "enum": ["main", "secondary"] },
        "position": { "enum": ["left", "right", "unknown"], "default": "unknown", "description": "Side of the mount. Processing can detect this from feature matches when unknown." },
        "platform": { "enum": ["ios", "android"] },
        "model": { "type": "string" },
        "appVersion": { "type": "string" },
        "video": {
          "type": "object",
          "required": ["width", "height", "nominalFps", "codec", "lens"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer" },
            "height": { "type": "integer" },
            "nominalFps": { "type": "number", "description": "Requested frame rate. Phones record variable frame rate; processing resamples on presentation timestamps." },
            "codec": { "enum": ["hevc", "h264"] },
            "bitrateBps": { "type": "integer" },
            "lens": { "enum": ["ultrawide", "wide"] },
            "stabilization": { "type": "boolean", "description": "Must be false; stabilization breaks the fixed stitch." }
          }
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/segment" }
        }
      }
    },
    "segment": {
      "type": "object",
      "required": ["index", "objectKey", "bytes", "sha256", "startedAtDeviceMs", "durationMs"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "objectKey": { "type": "string", "description": "S3 key the segment uploads to." },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "startedAtDeviceMs": { "type": "integer", "description": "Device clock (ms since epoch) when the first frame was captured." },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
