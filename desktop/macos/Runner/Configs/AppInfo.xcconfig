// Application-level settings for the Runner target.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = OpenSportsBall

// The application's bundle identifier (the phone app is dev.opensportsball.opensportsball).
PRODUCT_BUNDLE_IDENTIFIER = dev.opensportsball.mac

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 The OpenSportsBall Authors. Apache-2.0.
